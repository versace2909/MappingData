{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "S3": {
    "ServiceURL": "http://localhost:4566",
    "BucketName": "mims-data-sources",
    "ForcePathStyle": true
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Outbox": {
    "IntervalSeconds": 10
  }
}
