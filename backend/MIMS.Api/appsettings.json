{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=mims;Username=mims_user;Password=mims_password"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "S3": {
    "ServiceURL": "",
    "BucketName": "mims-data-sources",
    "ForcePathStyle": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Outbox": {
    "IntervalSeconds": 10
  }
}
